# --- Wajib -------------------------------------------------------------------
BOT_TOKEN=
GOOGLE_MAPS_API_KEY=
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
# Isi POSTGRES_URI, atau DB_NAME/DB_USER/DB_PASS/DB_HOST/DB_PORT
POSTGRES_URI=
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
# sslmode bila tidak ditulis di POSTGRES_URI (default: disable)
DB_SSLMODE=

# --- Telegram ----------------------------------------------------------------
# URL publik endpoint /webhook/telegram. Kosongkan untuk mode long polling.
WEBHOOK_URL=https://bot.laukpauk.id/webhook/telegram
# Opsional: secret yang dicek di header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
LISTEN_ADDR=:5000
ADMIN_USER_ID=5464224951

# --- Google Sheets (opsional; kosongkan keduanya untuk menonaktifkan) --------
CREDENTIALS_PATH=
SPREADSHEET_ID=

# --- Toko --------------------------------------------------------------------
STORE_LAT=3.539174131612625
STORE_LNG=98.64453142910467
ONGKOS_PER_KM=3000
XENDIT_REDIRECT_URL=https://t.me/Laukpauk_Bot
TZ_NAME=Asia/Jakarta

# --- Penyimpanan -------------------------------------------------------------
# Folder untuk state.json (sesi, keranjang, voucher, invoice tertunda) dan holidays.json
STATE_DIR=data
# Opsional: simpan salinan PDF invoice di folder ini
INVOICE_DIR=
DEBUG=false
